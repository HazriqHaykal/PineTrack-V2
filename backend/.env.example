# Copy this file to .env and fill in real values there. Never put real keys in this file.

# SQLite needs no setup. For Supabase use the "Session pooler" connection string:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./pinetrack.db
SECRET_KEY=your-super-secret-key-change-this-in-production
ENVIRONMENT=development

# Google Gemini API key for AI recommendations (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
